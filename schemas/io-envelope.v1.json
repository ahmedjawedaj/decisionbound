{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionbound.dev/schemas/io-envelope.v1.json",
  "title": "DecisionBound Input/Output Artifact Envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 3},
    "size_bytes": {"type": "integer", "minimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_kind": {"enum": ["user", "repository", "tool", "mcp", "agent", "benchmark"]},
    "visibility": {"enum": ["private", "project", "team", "public"]},
    "redacted": {"type": "boolean"},
    "storage_ref": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "artifact_id", "project_id", "media_type", "size_bytes", "sha256", "source_kind", "visibility", "redacted", "storage_ref"]
}
