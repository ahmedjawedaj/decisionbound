{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decisionbound:schemas:task-capsule.v1.json",
  "title": "TaskCapsule",
  "description": "Proposed v1 contract; not yet released as runtime API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "repo_id",
    "repo_commit",
    "objective",
    "required_constraint_ids",
    "acceptance_ids",
    "evidence_refs",
    "allowed_tool_ids",
    "max_steps",
    "max_cost_usd",
    "max_workers"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_commit": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "required_constraint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions_selected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions_rejected": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_tool_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_steps": {
      "type": "integer",
      "minimum": 1
    },
    "max_cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "max_workers": {
      "type": "integer",
      "minimum": 1
    },
    "requires_approval": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
