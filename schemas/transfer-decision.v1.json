{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decisionbound:schemas:transfer-decision.v1.json",
  "title": "TransferDecision",
  "description": "Proposed v1 contract; not yet released as runtime API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "decision_id",
    "disposition",
    "rationale",
    "source_evidence_refs",
    "target_evidence_refs",
    "authority_check",
    "review_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "disposition": {
      "enum": [
        "APPLY",
        "TRANSLATE",
        "ABSTAIN",
        "ESCALATE"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "target_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_check": {
      "enum": [
        "pass",
        "blocked",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "review_required": {
      "type": "boolean"
    }
  }
}
