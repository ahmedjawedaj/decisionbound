{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decisionbound:schemas:decision-record.v1.json",
  "title": "DecisionRecord",
  "description": "Proposed v1 contract; not yet released as runtime API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "revision",
    "statement",
    "intent",
    "status",
    "owner_scope",
    "owner_id",
    "source_project_id",
    "allowed_target_scopes",
    "source_evidence",
    "allow_cross_org"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "candidate",
        "approved",
        "rejected",
        "revoked",
        "expired"
      ]
    },
    "owner_scope": {
      "enum": [
        "personal",
        "project",
        "team",
        "organization"
      ]
    },
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "source_project_id": {
      "type": "string",
      "minLength": 1
    },
    "allowed_target_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "applicable_languages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "positive_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "negative_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "ref",
          "sha256",
          "kind"
        ]
      }
    },
    "reviewed_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "allow_cross_org": {
      "type": "boolean"
    }
  }
}
