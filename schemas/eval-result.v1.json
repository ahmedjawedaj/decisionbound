{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decisionbound:schemas:eval-result.v1.json",
  "title": "EvalResult",
  "description": "Proposed v1 contract; not yet released as runtime API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "harness_id",
    "baseline_id",
    "model_id",
    "repo_commit",
    "verified_success",
    "negative_transfer",
    "disposition",
    "cost_usd",
    "latency_ms",
    "verifier_evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "harness_id": {
      "type": "string",
      "minLength": 1
    },
    "baseline_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_commit": {
      "type": "string",
      "minLength": 1
    },
    "verified_success": {
      "type": "boolean"
    },
    "negative_transfer": {
      "type": "boolean"
    },
    "disposition": {
      "enum": [
        "APPLY",
        "TRANSLATE",
        "ABSTAIN",
        "ESCALATE",
        "NONE"
      ]
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0
    },
    "verifier_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
