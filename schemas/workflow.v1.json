{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decisionbound.dev/schemas/workflow.v1.json",
  "title": "DecisionBound bounded workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "max_workers": {"type": "integer", "minimum": 1, "maximum": 8},
    "max_total_cost_usd": {"type": "number", "minimum": 0, "maximum": 100},
    "approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "kind", "description"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "kind": {"enum": ["prepare", "inspect", "mock", "code", "review"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 3000},
          "role": {"enum": ["general", "planner", "researcher", "implementer", "reviewer", "tester"]},
          "depends_on": {"type": "array", "maxItems": 16, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}},
          "max_attempts": {"type": "integer", "minimum": 1, "maximum": 4},
          "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 100},
          "max_context_tokens": {"type": "integer", "minimum": 100, "maximum": 20000}
        }
      }
    }
  }
}
