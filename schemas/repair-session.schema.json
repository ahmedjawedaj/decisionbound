{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionBound durable repair session metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "status", "request_sha256", "contract_sha256", "max_attempts", "cost_usd", "feedback", "attempts"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string", "pattern": "^repair_[0-9a-f]{32}$"},
    "status": {"type": "string", "enum": ["running", "verified", "exhausted", "blocked", "needs_real_tests"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
    "cost_usd": {"type": "number", "minimum": 0},
    "feedback": {"type": "object"},
    "attempts": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["number", "run_id", "status", "summary"],
      "properties": {
        "number": {"type": "integer", "minimum": 1, "maximum": 5},
        "run_id": {"type": "string", "pattern": "^code_[0-9a-f]{32}$"},
        "status": {"type": "string", "enum": ["in_flight", "passed", "failed_test", "failed_contract", "mock_passed", "blocked"]},
        "summary": {"type": "object"}
      }
    }}
  }
}
