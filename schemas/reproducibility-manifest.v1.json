{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:decisionbound:schemas:reproducibility-manifest.v1.json",
  "title": "ReproducibilityManifest",
  "description": "Proposed v1 contract; not yet released as runtime API.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "dataset_commit",
    "dataset_split_hash",
    "harness_versions",
    "model_snapshots",
    "provider_price_sheet_ref",
    "tool_catalog_hash",
    "skill_catalog_hash",
    "policy_revision",
    "sandbox_image_digest",
    "run_ids",
    "analysis_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "dataset_commit": {
      "type": "string",
      "minLength": 1
    },
    "dataset_split_hash": {
      "type": "string",
      "minLength": 1
    },
    "harness_versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "model_snapshots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provider_price_sheet_ref": {
      "type": "string",
      "minLength": 1
    },
    "tool_catalog_hash": {
      "type": "string",
      "minLength": 1
    },
    "skill_catalog_hash": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "minLength": 1
    },
    "sandbox_image_digest": {
      "type": "string",
      "minLength": 1
    },
    "run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "analysis_revision": {
      "type": "string",
      "minLength": 1
    }
  }
}
